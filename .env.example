# Copy to .env and fill in. Never commit .env.

# Postgres connection string from Supabase: Project Settings > Database >
# Connection string. Use the Session or Transaction pooler string; its host and
# the "postgres.<project-ref>" user must match your project's region exactly,
# or the pooler answers "tenant/user not found". Read by Prisma
# (prisma.config.ts and src/lib/prisma-client.ts).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Direct (non-pooled) connection string from the same Supabase page, for
# migrations and `prisma db push`. Nothing in the code reads it yet, so the
# app runs without it.
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Supabase Auth, Storage and Realtime: Project Settings > API.
# VITE_SUPABASE_URL is the project URL; VITE_SUPABASE_KEY is the anon (public)
# key. Both reach the browser, so never put the service-role key here.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_KEY="<anon-key>"
